ADMIN_PASSWORD=ipcheck
TRUST_PROXY=true
# IP/CIDR proxy tepercaya (dipisah koma). Header X-Forwarded-For hanya
# dihormati kalau request datang dari IP ini. Contoh: 192.168.0.0/16 untuk
# NPM di LAN, 100.64.0.0/10 untuk akses via Tailscale, 172.30.0.1 = gateway
# docker host. Kosong + TRUST_PROXY=true = semua proxy dipercaya (risky).
TRUSTED_PROXIES=192.168.0.0/16,172.30.0.1,127.0.0.1,100.64.0.0/10
APP_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta
